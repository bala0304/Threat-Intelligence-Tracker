# Database Configuration
# Postgres is the primary runtime database so the schema, driver, and ingestion
# behavior stay aligned with downstream intelligence stores.
DATABASE_URL=postgresql://threat_intel_user:threat_intel_password@localhost:5432/threat_intel_db

# Shodan API
SHODAN_API_KEY=your_shodan_api_key

# Censys API
CENSYS_PAT=your_censys_personal_access_token_here

# Binary Edge API
BINARY_EDGE_API_KEY=your_binary_edge_api_key

# Zoomeye API
ZOOMEYE_API_KEY=your_zoomeye_api_key

# Passive DNS Services
PASSIVE_DNS_API_KEY=your_passive_dns_api_key

# Threat Intelligence Feeds
THREATFOX_API_URL=https://threatfox-api.abuse.ch/api/v1/
# abuse.ch now requires an Auth-Key for ThreatFox and URLhaus.
# Get one free at https://auth.abuse.ch/
THREATFOX_AUTH_KEY=your_threatfox_auth_key
# Optional aliases for the same abuse.ch Auth-Key:
# ABUSECH_AUTH_KEY=your_abusech_auth_key
# URLHAUS_AUTH_KEY=your_urlhaus_auth_key
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1/

# Set to true only if your environment needs system proxy vars for outbound HTTP
HTTP_TRUST_ENV=false

# Application Settings
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501

# Optional: Real-time processing
ENABLE_REALTIME=false
UPDATE_INTERVAL_MINUTES=60
